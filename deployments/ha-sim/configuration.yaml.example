# Home Assistant configuration for ha-sim (simulator instance)
# Copy this file to your ha-sim config directory before first run:
#   cp configuration.yaml.example /home/willem/docker_files/ha-sim/config/configuration.yaml
#
# This ensures HA runs on port 8124 instead of the default 8123
# (which is used by your production HA instance).

homeassistant:
  name: Home Simulator
  latitude: 52.0
  longitude: 5.0
  elevation: 0
  unit_system: metric
  time_zone: Europe/Amsterdam
  country: NL
  language: en

# Note: HTTP server port (8124) is configured via the UI under
# Settings > System > Network. It was migrated from YAML in HA 2026.8.
# The .storage/http file stores: {"server_port": 8124, "yaml_migration_done": true}

# Enable standard integrations (excluding bluetooth to avoid container permission warnings)
api:
automation:
config:
counter:
dhcp:
energy:
frontend:
history:
homeassistant_hardware:
input_boolean:
input_button:
input_datetime:
input_number:
input_select:
input_text:
logbook:
media_source:
my:
person:
scene:
script:
select:
sun:
system_health:
tag:
timer:
webhook:
zone:

# Logging configuration
logger:
  default: info

# Example: Enable ramses_cc integration (configure via UI after first start)
# ramses_cc:
